          "Description": "Value of expression at line 11",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "//split min_max list\nmin_delta = min_max[0];\nmax_delta = min_max[1];\n\n//find value outside min_max range\nmin_bool = min_delta>=deltas?true:false;\n\nmax_bool = max_delta<=deltas?true:false;\n\n//any true\nmin_bool || max_bool;"
    },
