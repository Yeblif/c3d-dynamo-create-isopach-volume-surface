    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nclr.AddReference(\"DSCoreNodes\")\r\n\r\nfrom DSCore import Color\r\n\r\nmins = IN[0]\r\nmaxs = IN[1]\r\n\r\ncut_colour_in = IN[2]\r\nfill_colour_in = IN[3]\r\nzero_colour_in = IN[4]\r\n\r\ndef ds_colour_to_rgb(c):\r\n    return [int(c.Red), int(c.Green), int(c.Blue)]\r\n\r\ndef lerp(a, b, t):\r\n    return int(round(a + (b - a) * t))\r\n\r\ndef blend(c1, c2, t):\r\n    return [\r\n        lerp(c1[0], c2[0], t),\r\n        lerp(c1[1], c2[1], t),\r\n        lerp(c1[2], c2[2], t)\r\n    ]\r\n\r\nzero_colour = ds_colour_to_rgb(zero_colour_in)\r\ncut_colour = ds_colour_to_rgb(cut_colour_in)\r\nfill_colour = ds_colour_to_rgb(fill_colour_in)\r\n\r\n# classify bands\r\ncut_indices = []\r\nfill_indices = []\r\n\r\nfor i, pair in enumerate(zip(mins, maxs)):\r\n    low, high = pair\r\n\r\n    if high <= 0:\r\n        cut_indices.append(i)\r\n    elif low >= 0:\r\n        fill_indices.append(i)\r\n\r\ncolours = [None] * len(mins)\r\n\r\n# Cut: deepest cut darkest, nearest zero palest\r\ncut_count = len(cut_indices)\r\n\r\nfor rank, i in enumerate(cut_indices):\r\n    if cut_count == 1:\r\n        t = 1\r\n    else:\r\n        # rank 0 = deepest cut, rank last = nearest zero\r\n        t = 1 - (float(rank) / float(cut_count - 1))\r\n\r\n    rgb = blend(zero_colour, cut_colour, t)\r\n    colours[i] = Color.ByARGB(255, rgb[0], rgb[1], rgb[2])\r\n\r\n# Fill: nearest zero palest, highest fill darkest\r\nfill_count = len(fill_indices)\r\n\r\nfor rank, i in enumerate(fill_indices):\r\n    if fill_count == 1:\r\n        t = 1\r\n    else:\r\n        # rank 0 = nearest zero, rank last = highest fill\r\n        t = float(rank) / float(fill_count - 1)\r\n\r\n    rgb = blend(zero_colour, fill_colour, t)\r\n    colours[i] = Color.ByARGB(255, rgb[0], rgb[1], rgb[2])\r\n\r\n# fallback for any cross-zero bands\r\nfor i in range(len(colours)):\r\n    if colours[i] is None:\r\n        colours[i] = Color.ByARGB(\r\n            255,\r\n            zero_colour[0],\r\n            zero_colour[1],\r\n            zero_colour[2]\r\n        )\r\n\r\nOUT = colours",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "3c4757cf966b4c7b86860170525317f2",
