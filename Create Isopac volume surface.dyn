    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nclr.AddReference(\"AcMgd\")\r\nclr.AddReference(\"AcDbMgd\")\r\nclr.AddReference(\"AeccDbMgd\")\r\n\r\nfrom Autodesk.AutoCAD.ApplicationServices import Application\r\nfrom Autodesk.AutoCAD.DatabaseServices import OpenMode\r\nfrom Autodesk.Civil.ApplicationServices import CivilApplication\r\n\r\nsurface_name = IN[0]\r\n\r\nadoc = Application.DocumentManager.MdiActiveDocument\r\ndb = adoc.Database\r\ncivil_doc = CivilApplication.ActiveDocument\r\n\r\nresult = None\r\n\r\nlock = adoc.LockDocument()\r\ntry:\r\n    with db.TransactionManager.StartTransaction() as t:\r\n        for sid in civil_doc.GetSurfaceIds():\r\n            surf = t.GetObject(sid, OpenMode.ForRead)\r\n\r\n            if surf.Name == surface_name:\r\n                props = surf.GetGeneralProperties()\r\n\r\n                result = [\r\n                    props.MinimumElevation,\r\n                    props.MaximumElevation\r\n                ]\r\n                break\r\n\r\n        t.Commit()\r\nfinally:\r\n    lock.Dispose()\r\n\r\nOUT = result",
      "Engine": "IronPython2",
      "VariableInputPorts": true,
      "Id": "0a98d1005a2e401c9bc04cca1e9862b7",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "70178fe6c48d4dd8adfc560ce581e2d1",
          "Name": "Vol_Surface",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "5e064f2b9bc94b2cbc43099f513be122",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
